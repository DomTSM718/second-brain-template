# Normalise line endings. Critical: hook scripts MUST stay LF or Git Bash
# fails on them after a Windows checkout ("bad interpreter: \r").
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
